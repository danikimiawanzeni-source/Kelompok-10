        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Admin\nboundary \&quot;ReservasiUI\&quot; as UI\ncontrol \&quot;ReservasiController\&quot; as Ctrl\nentity \&quot;Tabel reservasi\&quot; as DB\n\nAdmin -&gt; UI : 1. bukaKelolaReservasi()\nactivate UI\nUI -&gt; Ctrl : 2. getAllReservasi()\nactivate Ctrl\nCtrl -&gt; DB : 3. selectAll()\nactivate DB\nDB --&gt; Ctrl : 4. dataReservasi\ndeactivate DB\nCtrl --&gt; UI : 5. tampilkanData()\nUI --&gt; Admin : 6. Daftar Reservasi Ditampilkan\n\nAdmin -&gt; UI : 7. ubahDataStatus()\nAdmin -&gt; UI : 8. klikSimpan()\nUI -&gt; Ctrl : 9. prosesUpdate(data)\n\nalt Data Valid\n    Ctrl -&gt; DB : 10. updateReservasi(data)\n    activate DB\n    DB --&gt; Ctrl : 11. statusBerhasil\n    deactivate DB\n    Ctrl --&gt; UI : 12. updateHalaman()\n    UI --&gt; Admin : 13. Tampilkan Pesan Sukses\nelse Data Tidak Valid\n    Ctrl --&gt; UI : 14. pesanError()\n    UI --&gt; Admin : 15. Tampilkan Pesan Kesalahan\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="TXGlv_tFFwL_BT-7Tek4-1">
