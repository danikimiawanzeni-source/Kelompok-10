        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Pelanggan\nboundary \&quot;RiwayatUI\&quot; as UI\ncontrol \&quot;ReservasiController\&quot; as Ctrl\nentity \&quot;Tabel reservasi\&quot; as DB\n\nPelanggan -&gt; UI : 1. bukaRiwayatReservasi()\nactivate UI\nUI -&gt; Ctrl : 2. getRiwayatByPelanggan(id)\nactivate Ctrl\nCtrl -&gt; DB : 3. selectRiwayat(id)\nactivate DB\nDB --&gt; Ctrl : 4. dataRiwayat\ndeactivate DB\n\nalt Hasil Ditemukan\n    Ctrl --&gt; UI : 5. returnData\n    UI --&gt; Pelanggan : 6. tampilkanDaftarRiwayat(Status)\nelse Hasil Tidak Ditemukan\n    Ctrl --&gt; UI : 7. pesanKosong\n    UI --&gt; Pelanggan : 8. tampilkanPesanDataTidakAda()\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="U-nM0GaH1VHK-p0Txl3B-1">
