        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Admin\nboundary \&quot;ValidasiUI\&quot; as UI\ncontrol \&quot;ValidasiController\&quot; as Ctrl\nentity \&quot;Tabel pembayaran\\n&amp; reservasi\&quot; as DB\n\nAdmin -&gt; UI : 1. bukaDaftarPending()\nactivate UI\nUI -&gt; Ctrl : 2. requestDataPembayaran()\nactivate Ctrl\nCtrl -&gt; DB : 3. selectDataJoin()\nactivate DB\nDB --&gt; Ctrl : 4. returnData\ndeactivate DB\nCtrl --&gt; UI : 5. tampilkanDaftarDanBukti()\nUI --&gt; Admin : 6. Cek Kesesuaian Bukti\n\nalt Bukti Sesuai (Klik Konfirmasi)\n    Admin -&gt; UI : 7. klikKonfirmasi()\n    UI -&gt; Ctrl : 8. requestApprove()\n    Ctrl -&gt; DB : 9. updatePembayaran(&#39;Lunas&#39;)\n    activate DB\n    deactivate DB\n    Ctrl -&gt; DB : 10. updateReservasi(&#39;Dikonfirmasi&#39;)\n    activate DB\n    deactivate DB\n    Ctrl --&gt; UI : 11. notifikasiBerhasil\n    UI --&gt; Admin : 12. Tampilkan Pesan Sukses\nelse Bukti Tidak Sesuai (Klik Tolak)\n    Admin -&gt; UI : 13. klikTolak()\n    UI -&gt; Ctrl : 14. requestReject()\n    Ctrl -&gt; DB : 15. updatePembayaran(&#39;Ditolak&#39;)\n    activate DB\n    deactivate DB\n    Ctrl -&gt; DB : 16. updateReservasi(&#39;Ditolak&#39;)\n    activate DB\n    deactivate DB\n    Ctrl --&gt; UI : 17. notifikasiDitolak\n    UI --&gt; Admin : 18. Tampilkan Pesan Ditolak\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="KDV3v_72txltgTm_kX3i-1">
