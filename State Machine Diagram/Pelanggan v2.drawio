        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Admin\nboundary \&quot;LapanganUI\&quot; as UI\ncontrol \&quot;LapanganController\&quot; as Ctrl\nentity \&quot;Tabel lapangan\&quot; as DB\n\nAdmin -&gt; UI : 1. pilihMenuLapangan()\nactivate UI\nUI --&gt; Admin : 2. tampilkanHalaman()\nAdmin -&gt; UI : 3. inputData(Tambah/Edit/Hapus)\nAdmin -&gt; UI : 4. klikSimpan()\nUI -&gt; Ctrl : 5. prosesData(data)\nactivate Ctrl\nCtrl -&gt; Ctrl : 6. validasiData()\n\nalt Data Lengkap\n    Ctrl -&gt; DB : 7. simpanData(data)\n    activate DB\n    DB --&gt; Ctrl : 8. statusBerhasil\n    deactivate DB\n    Ctrl --&gt; UI : 9. updateHalaman()\n    UI --&gt; Admin : 10. Tampilkan Pesan Sukses\nelse Data Tidak Lengkap\n    Ctrl --&gt; UI : 11. pesanError()\n    UI --&gt; Admin : 12. Tampilkan Pesan Kesalahan\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="xlr3TaSLbWUWKeYeNehW-1">
