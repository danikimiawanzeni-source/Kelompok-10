        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Pengguna\nboundary \&quot;LoginUI\&quot; as UI\ncontrol \&quot;AuthController\&quot; as Ctrl\nentity \&quot;Tabel users\&quot; as DB\n\nPengguna -&gt; UI : 1. inputKredensial()\nactivate UI\nUI -&gt; Ctrl : 2. requestLogin(email, password)\nactivate Ctrl\nCtrl -&gt; DB : 3. selectUserByEmail(email)\nactivate DB\nDB --&gt; Ctrl : 4. returnData(hash, role)\ndeactivate DB\nCtrl -&gt; Ctrl : 5. verifikasiPassword()\n\nalt Login Valid\n    alt Role == Admin\n        Ctrl --&gt; UI : 6. redirectAdmin\n        UI --&gt; Pengguna : 7. tampilkanDashboardAdmin()\n    else Role == Pelanggan\n        Ctrl --&gt; UI : 8. redirectPelanggan\n        UI --&gt; Pengguna : 9. tampilkanDashboardPelanggan()\n    end\nelse Login Tidak Valid\n    Ctrl --&gt; UI : 10. returnError\n    UI --&gt; Pengguna : 11. tampilkanPesanError()\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="1coc1q0jOnyO6llsBlz4-1">
