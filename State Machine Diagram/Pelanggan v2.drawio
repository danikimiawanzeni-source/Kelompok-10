  <diagram id="pX7fPI-7e2VCyj7wa9E4" name="sequence Reservasi (Pelanggan)">
    <mxGraphModel dx="793" dy="1476" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Pelanggan\nboundary \&quot;ReservasiUI\&quot; as UI\ncontrol \&quot;ReservasiController\&quot; as Ctrl\nentity \&quot;Tabel reservasi\\n&amp; lapangan\&quot; as DB\n\nPelanggan -&gt; UI : 1. inputJadwalDanLapangan()\nactivate UI\nUI -&gt; Ctrl : 2. cekKetersediaan()\nactivate Ctrl\nCtrl -&gt; DB : 3. queryCekBentrok(Tabel reservasi)\nactivate DB\nDB --&gt; Ctrl : 4. hasilPengecekan\ndeactivate DB\n\nalt Jadwal Tersedia\n    Ctrl -&gt; DB : 5. getHarga(Tabel lapangan)\n    activate DB\n    DB --&gt; Ctrl : 6. returnHarga\n    deactivate DB\n    Ctrl -&gt; Ctrl : 7. hitungTotalHarga()\n    Ctrl -&gt; DB : 8. insertDataReservasi(&#39;Belum Bayar&#39;)\n    activate DB\n    deactivate DB\n    Ctrl --&gt; UI : 9. reservasiBerhasil\n    UI --&gt; Pelanggan : 10. tampilkanHalamanTagihan()\nelse Jadwal Bertabrakan\n    Ctrl --&gt; UI : 11. returnError\n    UI --&gt; Pelanggan : 12. tampilkanError\&quot;Jadwal Dipesan\&quot;()\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iJZbofiQ5QmXTzNrZxsB-1">
