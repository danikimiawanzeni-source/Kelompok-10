        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Pelanggan\nboundary \&quot;LapanganUI\&quot; as UI\ncontrol \&quot;LapanganController\&quot; as Ctrl\nentity \&quot;Tabel lapangan\&quot; as DB\n\nPelanggan -&gt; UI : 1. bukaDaftarLapangan()\nactivate UI\nUI -&gt; Ctrl : 2. getDaftarLapangan()\nactivate Ctrl\nCtrl -&gt; DB : 3. selectDataLapangan()\nactivate DB\nDB --&gt; Ctrl : 4. dataLapangan\ndeactivate DB\n\nalt Data Tersedia\n    Ctrl --&gt; UI : 5. returnData\n    UI --&gt; Pelanggan : 6. tampilkanDaftarLapangan()\nelse Data Tidak Tersedia\n    Ctrl --&gt; UI : 7. pesanKosong\n    UI --&gt; Pelanggan : 8. tampilkanPesan\&quot;Data Kosong\&quot;()\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="twcCuIOcoYdXH3mm3q7P-1">
