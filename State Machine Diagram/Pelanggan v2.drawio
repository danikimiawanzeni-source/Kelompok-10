        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Admin\nboundary \&quot;LaporanUI\&quot; as UI\ncontrol \&quot;LaporanController\&quot; as Ctrl\nentity \&quot;Tabel reservasi\\n&amp; pembayaran\&quot; as DB\n\nAdmin -&gt; UI : 1. bukaMenuLaporan()\nactivate UI\nAdmin -&gt; UI : 2. inputFilterTanggal()\nAdmin -&gt; UI : 3. klikTampilkan()\nUI -&gt; Ctrl : 4. requestLaporan(filter)\nactivate Ctrl\nCtrl -&gt; DB : 5. selectDataByDate(filter)\nactivate DB\nDB --&gt; Ctrl : 6. dataTransaksi\ndeactivate DB\n\nalt Data Ditemukan\n    Ctrl --&gt; UI : 7. returnLaporanData\n    UI --&gt; Admin : 8. tampilkanRekapitulasi()\nelse Data Tidak Ditemukan\n    Ctrl --&gt; UI : 9. pesanKosong\n    UI --&gt; Admin : 10. tampilkan\&quot;Data Laporan Kosong\&quot;()\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3t0MdxzWKAPEDVEXSQSF-1">
