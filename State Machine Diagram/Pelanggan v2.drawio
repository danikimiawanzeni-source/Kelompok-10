        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Admin\nboundary \&quot;PenggunaUI\&quot; as UI\ncontrol \&quot;UserController\&quot; as Ctrl\nentity \&quot;Tabel users\&quot; as DB\n\nAdmin -&gt; UI : 1. bukaKelolaPengguna()\nactivate UI\nUI -&gt; Ctrl : 2. getAllUsers()\nactivate Ctrl\nCtrl -&gt; DB : 3. selectAll()\nactivate DB\nDB --&gt; Ctrl : 4. dataUsers\ndeactivate DB\nCtrl --&gt; UI : 5. tampilkanData()\nUI --&gt; Admin : 6. Daftar Pengguna Ditampilkan\n\nAdmin -&gt; UI : 7. inputData(Tambah/Edit/Hapus)\nAdmin -&gt; UI : 8. klikSimpan()\nUI -&gt; Ctrl : 9. prosesData(data)\nCtrl -&gt; Ctrl : 10. validasiData()\n\nalt Data Lengkap\n    Ctrl -&gt; DB : 11. eksekusiDataUsers(data)\n    activate DB\n    DB --&gt; Ctrl : 12. statusBerhasil\n    deactivate DB\n    Ctrl --&gt; UI : 13. updateHalaman()\n    UI --&gt; Admin : 14. Tampilkan Pesan Sukses\nelse Data Tidak Lengkap\n    Ctrl --&gt; UI : 15. pesanError()\n    UI --&gt; Admin : 16. Tampilkan Pesan Kesalahan\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FfZ4u5pe8t-pZoqe7h7Q-1">
