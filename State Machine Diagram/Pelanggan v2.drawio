        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nactor Pelanggan\nboundary \&quot;PembayaranUI\&quot; as UI\ncontrol \&quot;PembayaranController\&quot; as Ctrl\nentity \&quot;Tabel pembayaran\\n&amp; reservasi\&quot; as DB\n\nPelanggan -&gt; UI : 1. uploadBuktiDanKirim()\nactivate UI\nUI -&gt; Ctrl : 2. submitForm(file, data)\nactivate Ctrl\nCtrl -&gt; Ctrl : 3. validasiFormatFile()\n\nalt Format File Valid\n    Ctrl -&gt; Ctrl : 4. simpanKeFolderUploads()\n    Ctrl -&gt; DB : 5. insertTabelPembayaran()\n    activate DB\n    deactivate DB\n    Ctrl -&gt; DB : 6. updateStatusReservasi(&#39;Menunggu Validasi&#39;)\n    activate DB\n    DB --&gt; Ctrl : 7. statusBerhasil\n    deactivate DB\n    Ctrl --&gt; UI : 8. uploadBerhasil\n    UI --&gt; Pelanggan : 9. tampilkanStatusMenungguValidasi()\nelse Format File Tidak Valid\n    Ctrl --&gt; UI : 10. uploadGagal\n    UI --&gt; Pelanggan : 11. tampilkanErrorFormat()\nend\ndeactivate Ctrl\ndeactivate UI\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="a4EUSfYo4rhuPyiDQ4Uq-1">
